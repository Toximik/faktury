# =============================================================================
# .env.example – Environment variable template for Fakturace.
#
# Instructions
# ------------
# 1. Copy this file to .env in the project root:
#      cp .env.example .env
#
# 2. Generate a secure SECRET_KEY:
#      python3 -c "import secrets; print(secrets.token_hex(32))"
#    Paste the output as the SECRET_KEY value below.
#
# 3. Fill in your supplier / business details.
#
# 4. Set correct ownership and permissions so only the app user can read it:
#      sudo chown faktury:faktury /srv/faktury/.env
#      sudo chmod 600 /srv/faktury/.env
#
# NEVER commit the real .env file to version control.
# This .env.example file (containing no secrets) is safe to commit.
# =============================================================================

# ── Application mode ──────────────────────────────────────────────────────────
# Set to "production" on the server. Any other value → development mode
# (activates /docs, /redoc, disables Secure cookie flag).
APP_ENV=production

# ── JWT Authentication ────────────────────────────────────────────────────────
# REQUIRED. Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Changing this value invalidates all existing sessions (users must log in again).
SECRET_KEY=REPLACE_WITH_OUTPUT_OF_secrets_token_hex_32

# Session duration in minutes. 480 = 8 hours.
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Database ──────────────────────────────────────────────────────────────────
# OPTIONAL. When unset, the app uses a SQLite file (faktury.db) in the project
# root — the default for the self-hosted single-user deployment.
#
# To run on a server database instead, point this at it (the driver package
# must be installed, e.g. `pip install "psycopg[binary]"`):
#   DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/faktury
#
# Schema is managed by Alembic and applied automatically on startup
# (`alembic upgrade head`); an existing SQLite database is adopted transparently
# on first run. See the "Database & migrations" section of CLAUDE.md.
# DATABASE_URL=sqlite:////weby/faktury.tmcm.cz/app/faktury.db

# ── Supplier / Issuer details ─────────────────────────────────────────────────
# NOTE: Supplier details are no longer configured here. They are stored per-user
# in the SupplierProfile database table and entered through the web UI on the
# "Účet" page after logging in. The legacy SUPPLIER_* environment variables are
# no longer read by the application.
